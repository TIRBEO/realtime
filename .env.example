# Tirbeo Realtime Platform — environment variables.
# All values must match the corresponding values on the api.tirbeo.app deployment.

# Shared with api.tirbeo.app — verifies the short-lived session access tokens.
JWT_SECRET=change-me

# Supabase Postgres (same as api) — used to check session validity and user status.
# Use the session-mode pooler (port 5432) so connections persist.
DATABASE_URL=postgresql://postgres.example:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Upstash Redis — cross-instance pub/sub + presence (same instance the api uses).
REDIS_URL=redis://default:change-me@example.upstash.io:6379

# Shared secret used by api.tirbeo.app to publish events via HTTP (optional).
# If unset, publishing falls back to Redis pub/sub only.
API_TOKEN=change-me

# Internal namespace for Redis channels (leave default unless you fork the platform).
RT_NAMESPACE=tirbeo:rt
