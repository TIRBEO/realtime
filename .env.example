# Tirbeo Realtime Platform — Cloudflare Worker environment variables.
# All values must match the corresponding values on api.tirbeo.app.

# Shared with api.tirbeo.app — verifies the short-lived session access tokens
# (HS256). Set with: npx wrangler secret put JWT_SECRET
JWT_SECRET=change-me

# Shared secret used by api.tirbeo.app to publish events via HTTP
# POST https://ws.tirbeo.app/api/publish. Set with: npx wrangler secret put API_TOKEN
API_TOKEN=change-me

# OPTIONAL — Supabase REST (PostgREST) credentials used to check session
# validity and user status (banned/suspended/admin_role) on connect.
# If unset, auth is signature-only and the admin role is read from the JWT
# `adminRole` claim (session revocation is not enforced).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=change-me

# Internal namespace (leave default unless you fork the platform).
RT_NAMESPACE=tirbeo:rt

# Local development secrets live in .dev.vars (gitignored).
